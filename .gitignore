# Claude Code per-user local settings (shared settings.json IS committed)
.claude/settings.local.json

# Property-based testing keeps a database of failing examples. It is genuinely
# useful locally — it replays the counter-example that found a bug — but it is
# machine-specific and must not be committed, least of all into a repository
# HACS copies wholesale onto someone's Home Assistant.
.hypothesis/
coverage.xml

# Rehearsal working state — the harness is tracked, what it generates is not.
tools/rehearsal/node*/config/*
!tools/rehearsal/node*/config/configuration.yaml
tools/rehearsal/*.log

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# Generated by tools/panel_preview/build_preview.py — regenerate, never commit.
tools/panel_preview/preview.html
.ha-matrix/
